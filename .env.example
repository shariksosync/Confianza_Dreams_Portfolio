# ==============================================================================
# Confianza Dreams & Events - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# For Vercel production deployment, configure these keys in:
# Vercel Project Dashboard -> Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Database Connection (Server-side only)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. MongoDB Atlas cluster connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/confianza_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Administrative Authentication & Security (Server-side only)
# ------------------------------------------------------------------------------
# Initial superadmin credentials for database seeding
ADMIN_EMAIL=confianzaevents@gmail.com
ADMIN_PASSWORD=your_strong_admin_password_here

# 32+ character random secret string used for signing admin session JWT tokens
ADMIN_SESSION_SECRET=your_super_secret_jwt_random_key_min_32_chars_here

# ------------------------------------------------------------------------------
# 3. Cloudinary Media Asset Management (Server-side only)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. Nodemailer & SMTP Email Notifications (Server-side only)
# ------------------------------------------------------------------------------
# SMTP Server hostname (e.g. smtp.gmail.com, smtp.sendgrid.net, etc.)
EMAIL_HOST=smtp.gmail.com
# Port 587 (STARTTLS, SMTP_SECURE=false) or Port 465 (SSL, SMTP_SECURE=true)
EMAIL_PORT=587
# SMTP username / sending email address
EMAIL_HOST_USER=your_sending_email@gmail.com
# SMTP password or Google App Password (16-character generated app password)
EMAIL_HOST_PASSWORD=your_smtp_app_password_here
# Set to "true" if using port 465, or "false" if using port 587
SMTP_SECURE=false
EMAIL_USE_TLS=True

# ------------------------------------------------------------------------------
# 5. Application & Domain Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
# Public site URL used for canonical metadata and absolute image links
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
